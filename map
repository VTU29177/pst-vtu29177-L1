import java.util.Arrays;
import java.util.List;
public class Map{
    public static void main(String[] args) {
        List<Integer> salaries = Arrays.asList(10000, 20000, 30000, 40000, 50000);
        // Filter salaries greater than 25000
        salaries.stream()
                .map(salary -> salary +salary+ 25000)
                .forEach(System.out::println);
    }
}
